---
import { content } from '../i18n/content';
import { getLang, localize, rich } from '../i18n';
const lang = getLang(Astro.currentLocale);
const c = content[lang];
const pillars = c.security.pillars;
---

<section class="relative py-24 lg:py-36">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <hr class="rule rule-fade mb-24 lg:mb-32" />
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <p data-reveal="wipe" class="eyebrow mb-5">{c.security.eyebrow}</p>
          <h2 data-reveal="mask" style="--reveal-delay:90ms" class="text-[length:var(--text-display)]" set:html={rich(c.security.title)} />
          <p data-reveal="up" style="--reveal-delay:200ms" class="mt-8 leading-relaxed text-mist">{c.security.lead}</p>
          <a href={localize('/terminos', lang)} data-reveal="up" style="--reveal-delay:300ms" class="link-underline mt-10 inline-block font-sans text-[0.72rem] uppercase tracking-[0.2em] text-gold">{c.security.link}</a>
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="grid gap-4 sm:grid-cols-2">
          {pillars.map((p, i) => (
            <div
              data-reveal="scale"
              style={`--reveal-delay:${i * 100}ms`}
              class="spotlight group relative overflow-hidden rounded-card border border-line/60 bg-surface/30 p-9 transition-colors duration-500 hover:border-gold/35 hover:bg-surface lg:p-11"
            >
              <span class="mb-7 block h-px w-12 rounded-full bg-gold/60 transition-all duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:w-20" />
              <h3 class="text-xl text-white">{p.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-mist">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
