---
import { seedsFlow } from '../data/site';
---

<section id="seeds" class="relative overflow-hidden py-24 lg:py-40">
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 size-[80vw] max-w-[900px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-35"
    style="background: radial-gradient(circle, rgba(224,169,87,0.16), rgba(224,169,87,0.05) 42%, transparent 72%)"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-[1400px] px-6 lg:px-10">
    <hr class="rule rule-fade mb-24 lg:mb-32" />
    <div class="grid items-center gap-16 lg:grid-cols-12 lg:gap-20">
      <!-- ── Moneda 3D (WebGL con fallback al SVG plano) ── -->
      <div class="order-2 lg:order-1 lg:col-span-5">
        <div data-reveal="scale" class="relative mx-auto w-full max-w-[340px]">
          <!-- Halo estático DETRÁS de la moneda. Importante: nada de
               filter/drop-shadow sobre el canvas ni sobre la Seed animada —
               un filtro sobre un elemento que se repinta cada frame obliga
               al navegador a recalcular la sombra 60 veces por segundo. -->
          <div
            class="pointer-events-none absolute inset-[-18%] z-0 rounded-full opacity-70"
            style="background: radial-gradient(circle, rgba(224,169,87,0.30), rgba(224,169,87,0.10) 45%, transparent 70%)"
            aria-hidden="true"
          ></div>
          <!-- La Seed plana se ve desde el primer instante; el canvas 3D se
               construye en tiempo muerto y entra con un fundido cuando está listo. -->
          <img
            src="/brand/seed.svg"
            alt="Seed de oro, la moneda de Chess Fortune"
            class="seed-fallback relative z-10 w-full animate-[coinFloat_9s_ease-in-out_infinite] transition-opacity duration-700"
          />
          <div
            class="seed3d absolute inset-0 z-20 cursor-grab opacity-0 transition-opacity duration-700 active:cursor-grabbing"
            style="touch-action: pan-y"
          ></div>
          <div class="pointer-events-none absolute inset-[-12%] animate-[spin_28s_linear_infinite] rounded-full border border-dashed border-gold/20" aria-hidden="true"></div>
          <div class="pointer-events-none absolute inset-[-24%] animate-[spin_46s_linear_infinite_reverse] rounded-full border border-gold/10" aria-hidden="true"></div>
        </div>
      </div>

      <div class="order-1 lg:order-2 lg:col-span-7">
        <p data-reveal="wipe" class="eyebrow mb-5">La moneda · Seeds</p>
        <h2 data-reveal="mask" style="--reveal-delay:90ms" class="text-[length:var(--text-display)]">
          Tu poder<br /> en el <span class="text-gilded">juego</span>.
        </h2>
        <p data-reveal="up" style="--reveal-delay:200ms" class="mt-8 max-w-xl text-lg leading-relaxed text-mist">
          Las Seeds son la moneda de Chess Fortune. No son un adorno: son la apuesta, el premio y la llave de acceso a las mesas altas. Un ciclo cerrado y transparente.
        </p>

        <ol class="mt-14 space-y-3">
          {seedsFlow.map((f, i) => (
            <li
              data-reveal="right"
              style={`--reveal-delay:${i * 120}ms`}
              class="spotlight group relative grid grid-cols-[auto_1fr] gap-6 overflow-hidden rounded-card border border-line/60 bg-surface/30 p-7 transition-all duration-500 hover:border-gold/40 hover:bg-surface/70 sm:grid-cols-[7rem_1fr] sm:gap-10"
            >
              <span class="font-display text-2xl text-gold">{f.step}</span>
              <div>
                <h3 class="text-lg text-white">{f.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-mist">{f.body}</p>
              </div>
              <span class="absolute bottom-4 left-0 top-4 w-px origin-top scale-y-0 rounded-full bg-gold transition-transform duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-y-100" />
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  /**
   * SEED DE ORO EN 3D — Three.js empaquetado localmente por Vite.
   * Moneda con grosor, oro metálico y el brote del SVG de marca
   * extruido en relieve sobre ambas caras. Gira sola y se puede
   * arrastrar. Fallback al SVG plano si no hay WebGL.
   */
  import * as THREE from 'three';
  import { SVGLoader } from 'three/addons/loaders/SVGLoader.js';

  const CFG = {
    gold: 0xe0a957,
    goldSoft: 0xffdba5,
    goldDeep: 0xbc7c1c,
    thickness: 0.16, // grosor de la moneda
    relieve: 0.045,  // altura del relieve del brote
    autoSpin: 0.35,  // rad/s
    floatAmp: 0.05,
  };

  async function buildCoin(holder: HTMLElement) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 20);
    camera.position.set(0, 0, 4.6);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'low-power' });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 1.75));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    holder.appendChild(renderer.domElement);

    /* Entorno de reflejos procedural: un equirect de 64×32 con degradado de
       estudio (techo cálido, banda de luz, suelo azul profundo). Da al metal
       el mismo carácter que RoomEnvironment por ~1% de su coste, que es lo
       que permitía que la construcción congelara el scroll en equipos lentos. */
    const cede = () => new Promise((r) => requestAnimationFrame(() => setTimeout(r, 0)));

    function crearEntorno() {
      const w = 64, h = 32;
      const data = new Uint8Array(w * h * 4);
      const mez = (a: number[], b: number[], t: number) => a.map((v, i) => v + (b[i] - v) * t);
      const techo = [255, 240, 214], medio = [224, 169, 87], suelo = [10, 14, 26];
      for (let y = 0; y < h; y++) {
        const t = y / (h - 1);
        let c = t < 0.5 ? mez(techo, medio, t * 2) : mez(medio, suelo, (t - 0.5) * 2);
        // banda de luz especular a media altura
        const brillo = Math.max(0, 1 - Math.abs(t - 0.38) * 9);
        c = mez(c, [255, 250, 235], brillo * 0.85);
        for (let x = 0; x < w; x++) {
          const i = (y * w + x) * 4;
          data[i] = c[0]; data[i + 1] = c[1]; data[i + 2] = c[2]; data[i + 3] = 255;
        }
      }
      const tex = new THREE.DataTexture(data, w, h);
      tex.mapping = THREE.EquirectangularReflectionMapping;
      tex.colorSpace = THREE.SRGBColorSpace;
      tex.needsUpdate = true;
      return tex;
    }

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromEquirectangular(crearEntorno()).texture;
    await cede();

    const key = new THREE.DirectionalLight(0xffdba5, 1.4);
    key.position.set(2.5, 2, 3);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0x9aa6c2, 0.5);
    rim.position.set(-3, -1, -2);
    scene.add(rim);

    const matBody = new THREE.MeshPhysicalMaterial({ color: CFG.gold, metalness: 1, roughness: 0.22, clearcoat: 0.4, clearcoatRoughness: 0.25 });
    const matDisc = new THREE.MeshPhysicalMaterial({ color: CFG.goldSoft, metalness: 1, roughness: 0.32 });
    const matSprout = new THREE.MeshPhysicalMaterial({ color: CFG.goldDeep, metalness: 1, roughness: 0.38, side: THREE.DoubleSide });

    const coin = new THREE.Group();
    scene.add(coin);

    const zAxis = (g: THREE.BufferGeometry) => { g.rotateX(Math.PI / 2); return g; };
    coin.add(new THREE.Mesh(zAxis(new THREE.CylinderGeometry(1, 1, CFG.thickness, 96)), matBody));
    coin.add(new THREE.Mesh(zAxis(new THREE.CylinderGeometry(0.8, 0.8, CFG.thickness + 0.012, 96)), matBody));
    coin.add(new THREE.Mesh(zAxis(new THREE.CylinderGeometry(0.67, 0.67, CFG.thickness + 0.022, 96)), matDisc));

    // Brote acuñado: extruimos el path real del SVG de marca
    const svgText = await fetch('/brand/seed.svg').then((r) => r.text());
    const d = /<path[^>]*\sd="([^"]+)"/.exec(svgText)?.[1];
    if (d) {
      const svgData = new SVGLoader().parse(`<svg xmlns="http://www.w3.org/2000/svg"><path d="${d}"/></svg>`);
      const shapes = svgData.paths.flatMap((p) => SVGLoader.createShapes(p));
      const geo = new THREE.ExtrudeGeometry(shapes, {
        depth: CFG.relieve,
        bevelEnabled: true,
        bevelThickness: 0.008,
        bevelSize: 0.006,
        bevelSegments: 2,
        curveSegments: 10,
      });
      geo.computeBoundingBox();
      const bb = geo.boundingBox!;
      const size = new THREE.Vector3();
      bb.getSize(size);
      const s = 1.0 / Math.max(size.x, size.y);
      geo.translate(-(bb.min.x + size.x / 2), -(bb.min.y + size.y / 2), 0);
      geo.scale(s, -s, 1); // -s: el eje Y del SVG apunta hacia abajo

      const front = new THREE.Mesh(geo, matSprout);
      front.position.z = CFG.thickness / 2 + 0.011;
      coin.add(front);
      const back = front.clone();
      back.rotation.y = Math.PI;
      back.position.z = -front.position.z;
      coin.add(back);
    }
    await cede();

    // Interacción: giro automático + arrastre + inclinación al cursor
    let targetRX = 0, targetRY = 0, dragging = false, px = 0, py = 0;
    holder.addEventListener('pointerdown', (e) => { dragging = true; px = e.clientX; py = e.clientY; holder.setPointerCapture(e.pointerId); });
    holder.addEventListener('pointermove', (e) => {
      if (dragging) {
        targetRY += (e.clientX - px) * 0.012;
        targetRX += (e.clientY - py) * 0.008;
        px = e.clientX; py = e.clientY;
      } else {
        const r = holder.getBoundingClientRect();
        targetRX = ((e.clientY - r.top) / r.height - 0.5) * 0.5;
      }
    });
    holder.addEventListener('pointerup', () => (dragging = false));
    holder.addEventListener('pointerleave', () => { if (!dragging) targetRX = 0; });

    const clock = new THREE.Clock();
    let rafId: number | null = null;

    function frame() {
      const dt = clock.getDelta();
      const t = clock.elapsedTime;
      if (!dragging) targetRY += CFG.autoSpin * dt;
      targetRX = Math.max(-0.9, Math.min(0.9, targetRX));
      coin.rotation.y += (targetRY - coin.rotation.y) * 0.08;
      coin.rotation.x += (targetRX - coin.rotation.x) * 0.06;
      coin.position.y = Math.sin(t * 0.8) * CFG.floatAmp;
      /* Mientras el usuario hace scroll, NO se renderiza: el giro se congela
         de forma imperceptible y retoma 250 ms después de soltar. Así el 3D
         tiene coste cero durante el desplazamiento en cualquier dispositivo. */
      if (dragging || performance.now() - ultimoScroll > 250) {
        renderer.render(scene, camera);
      }
      rafId = requestAnimationFrame(frame);
    }

    function resize() {
      const w = holder.clientWidth;
      const h = holder.clientHeight || w;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    new ResizeObserver(resize).observe(holder);
    resize();

    // Precompilar shaders y pintar un frame AHORA (estamos en tiempo muerto,
    // no durante el scroll del usuario) y recién entonces hacer el fundido.
    renderer.compile(scene, camera);
    renderer.render(scene, camera);
    holder.style.opacity = '1';
    holder.closest('[data-reveal]')?.querySelector<HTMLElement>('.seed-fallback')
      ?.style.setProperty('opacity', '0');

    if (reduced) {
      coin.rotation.set(0.15, -0.4, 0);
      renderer.render(scene, camera);
    } else {
      frame();
      // Pausa cuando la sección sale de pantalla
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) {
          if (rafId === null) { clock.getDelta(); frame(); }
        } else if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      }, { threshold: 0.05 }).observe(holder);
    }

    // Limpieza al navegar (View Transitions): liberar el contexto WebGL
    document.addEventListener('astro:before-swap', () => {
      if (rafId !== null) cancelAnimationFrame(rafId);
      renderer.dispose();
      pmrem.dispose();
    }, { once: true });
  }

  /* La construcción del 3D (shaders + entorno de reflejos) bloquea el hilo
     unos instantes. En máquinas lentas ese instante puede notarse, así que
     además de lanzarla en tiempo muerto, NUNCA se ejecuta mientras el
     usuario está desplazándose: espera a 400 ms de scroll en calma. */
  let ultimoScroll = 0;
  addEventListener('scroll', () => (ultimoScroll = performance.now()), { passive: true });

  function lanzar(holder: HTMLElement) {
    if (holder.dataset.init) return;
    holder.dataset.init = '1';
    const cuandoHayaCalma = () => {
      if (performance.now() - ultimoScroll < 400) {
        setTimeout(cuandoHayaCalma, 250);
        return;
      }
      buildCoin(holder).catch((err) => {
        console.warn('WebGL no disponible; se mantiene la moneda plana:', err);
        holder.remove(); // la Seed plana ya está visible debajo
      });
    };
    cuandoHayaCalma();
  }

  function initSeed3d() {
    document.querySelectorAll<HTMLElement>('.seed3d:not([data-init])').forEach((holder) => {
      /**
       * NO construir el 3D al llegar a la sección: la compilación de shaders
       * y el entorno de reflejos bloquean el hilo justo cuando el usuario
       * está haciendo scroll ("el scroll falla al pasar Features"). En su
       * lugar, dos disparadores que apuntan a tiempo muerto:
       *   1. requestIdleCallback tras la carga (caso normal), y
       *   2. un IntersectionObserver con 1200px de antelación, por si el
       *      usuario baja a toda velocidad antes de que llegue el idle.
       * Mientras tanto la Seed plana ya está en pantalla; el canvas entra
       * con un fundido cuando su primer frame está pintado.
       */
      const idle = (window as any).requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 1200));
      idle(() => lanzar(holder), { timeout: 3000 });

      const io = new IntersectionObserver(
        ([e]) => { if (e.isIntersecting) { io.disconnect(); lanzar(holder); } },
        { rootMargin: '1200px 0px' }
      );
      io.observe(holder);
    });
  }

  document.addEventListener('astro:page-load', initSeed3d);
</script>
