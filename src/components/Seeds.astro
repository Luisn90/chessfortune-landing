---
import { content } from '../i18n/content';
import { getLang, rich } from '../i18n';
import SeedMark from './SeedMark.astro';
const lang = getLang(Astro.currentLocale);
const c = content[lang];
const seedsFlow = c.seeds.flow;
const screens = c.seeds.screens as any[];
// Tablero en miniatura de la pantalla "Partida": dos casillas marcadas como última jugada
const squares = Array.from({ length: 64 }, (_, k) =>
  k === 28 || k === 36 ? 'bg-gold/35' : (Math.floor(k / 8) + k) % 2 === 0 ? 'bg-[#1b2440]' : 'bg-[#0e1426]'
);

// Monedas de fondo (render Blender del Seed de Oro, desenfoque horneado)
const coins = [
  { src: 'seed-3', w: 301, h: 298, depth: -7,  par: 0.35, float: '15s', delay: '-3s', pos: 'hidden lg:block left-[1%] top-[16%]',   size: 'w-[clamp(70px,6vw,95px)]',  op: 'opacity-60' },
  { src: 'seed-2', w: 404, h: 324, depth: -12, par: 0.25, float: '13s', delay: '-7s', pos: 'left-[2%] top-[4%] lg:left-[33%] lg:top-[12%]', size: 'w-[22vw] max-w-[90px] lg:w-[clamp(100px,9vw,140px)] lg:max-w-none', op: 'opacity-70 lg:opacity-90' },
  { src: 'seed-5', w: 313, h: 326, depth: -10, par: 0.3,  float: '14s', delay: '-1s', pos: 'hidden lg:block right-[5%] top-[5%]',    size: 'w-[clamp(80px,7vw,110px)]', op: 'opacity-60' },
  { src: 'seed-4', w: 403, h: 248, depth: -6,  par: 0.4,  float: '16s', delay: '-9s', pos: 'right-[3%] bottom-[4%] lg:right-[3%] lg:bottom-[6%]', size: 'w-[24vw] max-w-[100px] lg:w-[clamp(100px,9vw,140px)] lg:max-w-none', op: 'opacity-50' },
];
---

<section id="seeds" data-depth-root class="relative overflow-hidden py-24 lg:py-40">
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 size-[min(80vw,900px)] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-35"
    style="background: radial-gradient(closest-side, rgba(224,169,87,0.16), rgba(224,169,87,0.05) 42%, transparent 72%)"
    aria-hidden="true"
  ></div>

  <!-- Seeds flotando de fondo -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {coins.map((k) => (
      <div data-parallax={k.par} class:list={['absolute', k.pos]}>
        <div data-depth={k.depth} class="will-change-transform">
          <img src={`/seeds/${k.src}.webp`} alt="" width={k.w} height={k.h} loading="lazy" decoding="async"
            class:list={[k.size, k.op]} style={`animation: float ${k.float} ease-in-out ${k.delay} infinite`} />
        </div>
      </div>
    ))}
  </div>

  <div class="relative mx-auto max-w-[1400px] px-6 lg:px-10">
    <hr class="rule rule-fade mb-24 lg:mb-32" />
    <div class="grid items-center gap-16 lg:grid-cols-12 lg:gap-20">
      <!-- Móvil con pantallas (placeholders hasta tener capturas reales) -->
      <div class="order-2 lg:order-1 lg:col-span-5">
        <div data-reveal="scale" class="relative mx-auto w-[min(72vw,280px)]" data-seeds-phone>
          <div class="pointer-events-none absolute inset-[-30%] rounded-full" style="background: radial-gradient(closest-side, rgba(224,169,87,0.2), rgba(224,169,87,0.06) 45%, transparent 72%)" aria-hidden="true"></div>

          <div class="relative rounded-[2.6rem] border border-line bg-[#05070d] p-2.5 shadow-[0_40px_90px_-30px_rgba(0,0,0,0.9)]">
            <div class="relative aspect-[9/19] overflow-hidden rounded-[2.1rem] bg-navy">
              <span class="absolute left-1/2 top-2.5 z-20 h-5 w-20 -translate-x-1/2 rounded-full bg-black/90" aria-hidden="true"></span>

              {screens.map((s, i) => (
                <div
                  data-screen={i}
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${c.seeds.screenAria} ${i + 1}: ${s.tag}`}
                  aria-hidden={i === 0 ? undefined : 'true'}
                  class:list={['seeds-screen absolute inset-0 flex flex-col px-4 pb-5 pt-11', i === 0 && 'is-active']}
                >
                  {s.src ? (
                    <img src={s.src} alt="" class="absolute inset-0 size-full object-cover" />
                  ) : (
                    <Fragment>
                      <div class="flex items-center justify-between">
                        <span class="font-sans text-[0.55rem] uppercase tracking-[0.22em] text-gold">{s.tag}</span>
                        <span class="flex items-center gap-1.5 rounded-full border border-gold/25 bg-gold/10 px-2 py-0.5 font-sans text-[0.6rem] text-gold"><SeedMark class="size-3" />1.250</span>
                      </div>

                      {s.key === 'game' && (
                        <div class="mt-4 flex flex-1 flex-col">
                          <div class="flex items-center justify-between rounded-xl bg-surface/80 px-3 py-2 text-[0.65rem] text-mist">
                            <span>{s.rival}</span><span class="font-sans tabular-nums text-white/80">{s.clockRival}</span>
                          </div>
                          <div class="my-3 grid aspect-square grid-cols-8 overflow-hidden rounded-lg border border-line">
                            {squares.map((cls) => <span class={cls}></span>)}
                          </div>
                          <div class="flex items-center justify-between rounded-xl bg-surface/80 px-3 py-2 text-[0.65rem] text-mist">
                            <span>{s.you}</span><span class="font-sans tabular-nums text-gold">{s.clockYou}</span>
                          </div>
                          <div class="mt-auto flex items-center justify-between rounded-2xl border border-gold/30 bg-gold/10 px-4 py-3">
                            <span class="font-sans text-[0.55rem] uppercase tracking-[0.2em] text-gold/80">{s.pot}</span>
                            <span class="flex items-center gap-1.5 font-display text-xl text-white"><SeedMark class="size-4" />20</span>
                          </div>
                        </div>
                      )}

                      {s.key === 'wallet' && (
                        <div class="mt-5 flex flex-1 flex-col">
                          <div class="rounded-2xl border border-gold/25 bg-gradient-to-br from-gold/15 to-transparent p-4">
                            <p class="text-[0.6rem] text-mist">{s.balance}</p>
                            <p class="mt-1 flex items-center gap-2 font-display text-[2rem] leading-none text-white"><SeedMark class="size-6" />1.250</p>
                            <p class="mt-2 font-sans text-[0.6rem] text-mist/70">{s.approx}</p>
                          </div>
                          <ul class="mt-4 space-y-2">
                            {s.rows.map((r) => (
                              <li class="flex items-center justify-between rounded-xl bg-surface/70 px-3 py-2.5 text-[0.65rem]">
                                <span class="text-mist">{r[0]}</span>
                                <span class:list={['font-sans tabular-nums', r[1].startsWith('+') ? 'text-gold' : 'text-white/60']}>{r[1]}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}

                      {s.key === 'withdraw' && (
                        <div class="mt-5 flex flex-1 flex-col">
                          <p class="text-[0.6rem] text-mist">{s.amount}</p>
                          <div class="mt-2 flex items-center justify-between rounded-2xl border border-line bg-surface/80 px-4 py-3">
                            <span class="flex items-center gap-2 font-display text-2xl text-white"><SeedMark class="size-5" />500</span>
                            <span class="font-sans text-[0.55rem] uppercase tracking-[0.18em] text-mist/70">Seeds</span>
                          </div>
                          <p class="mt-4 text-[0.6rem] text-mist">{s.method}</p>
                          <div class="mt-2 flex items-center justify-between rounded-2xl border border-line bg-surface/80 px-4 py-3">
                            <span class="font-display text-2xl text-white">500</span>
                            <span class="rounded-full bg-[#26a17b]/15 px-2 py-0.5 font-sans text-[0.6rem] font-medium text-[#3fcf9f]">USDT</span>
                          </div>
                          <p class="mt-3 text-center font-sans text-[0.55rem] uppercase tracking-[0.18em] text-mist/60">{s.eta}</p>
                          <span class="btn-gold mt-auto flex justify-center py-3 font-sans text-[0.65rem] font-medium uppercase tracking-[0.2em] text-navy">{s.cta}</span>
                        </div>
                      )}
                    </Fragment>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- Seed en primer plano, por delante del móvil -->
          <div class="pointer-events-none absolute -bottom-[8%] -right-[10%] z-10 w-[36%] sm:-right-[22%] sm:w-[42%]" aria-hidden="true">
            <div data-depth="-22" class="will-change-transform">
              <img src="/seeds/seed-1.webp" alt="" width="422" height="426" loading="lazy" decoding="async" class="w-full drop-shadow-[0_20px_30px_rgba(0,0,0,0.55)]" style="animation: float 11s ease-in-out infinite" />
            </div>
          </div>

          <div class="mt-8 flex justify-center gap-2.5">
            {screens.map((s, i) => (
              <button type="button" data-dot={i} aria-label={`${c.seeds.screenAria} ${i + 1}: ${s.tag}`}
                class:list={['seeds-dot h-1.5 rounded-full bg-line transition-all duration-500', i === 0 ? 'is-active w-7' : 'w-1.5']} />
            ))}
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2 lg:col-span-7">
        <p data-reveal="wipe" class="eyebrow mb-5">{c.seeds.eyebrow}</p>
        <h2 data-reveal="mask" style="--reveal-delay:90ms" class="text-[length:var(--text-display)]" set:html={rich(c.seeds.title)} />
        <p data-reveal="up" style="--reveal-delay:200ms" class="mt-8 max-w-xl text-lg leading-relaxed text-mist">{c.seeds.lead}</p>

        <ol class="mt-14 space-y-3">
          {seedsFlow.map((f, i) => (
            <li
              data-reveal="right"
              data-flow={i}
              style={`--reveal-delay:${i * 120}ms`}
              class:list={['seeds-flow spotlight group relative grid cursor-default grid-cols-[auto_1fr] gap-6 overflow-hidden rounded-card border border-line/60 bg-surface/30 p-7 transition-all duration-500 hover:border-gold/40 hover:bg-surface/70 sm:grid-cols-[7rem_1fr] sm:gap-10', i === 0 && 'is-active']}
            >
              <span class="font-display text-2xl text-gold">{f.step}</span>
              <div>
                <h3 class="text-lg text-white">{f.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-mist">{f.body}</p>
              </div>
              <span class="flow-bar absolute bottom-4 left-0 top-4 w-px origin-top scale-y-0 rounded-full bg-gold transition-transform duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-y-100" />
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .seeds-screen { opacity: 0; transform: translateY(14px) scale(0.985); transition: opacity 0.7s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  .seeds-screen.is-active { opacity: 1; transform: none; }
  .seeds-dot.is-active { background: var(--color-gold); }
  .seeds-flow.is-active { border-color: color-mix(in oklab, var(--color-gold) 40%, transparent); background: color-mix(in oklab, var(--color-surface) 70%, transparent); }
  .seeds-flow.is-active .flow-bar { transform: scaleY(1); }
  @media (prefers-reduced-motion: reduce) { .seeds-screen { transition: none; transform: none; } }
</style>

<script>
  import '../scripts/depth';

  // Carrusel de pantallas: pasa solo, sincronizado con Gana / Guarda / Retira
  function initSeedsPhone() {
    const root = document.getElementById('seeds');
    if (!root || root.dataset.phoneBound) return;
    root.dataset.phoneBound = '1';
    const screens = Array.from(root.querySelectorAll<HTMLElement>('[data-screen]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const flows = Array.from(root.querySelectorAll<HTMLElement>('[data-flow]'));
    if (screens.length < 2) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0, timer = 0, visible = false, paused = false;

    const show = (i: number) => {
      idx = (i + screens.length) % screens.length;
      screens.forEach((s, k) => { s.classList.toggle('is-active', k === idx); s.toggleAttribute('aria-hidden', k !== idx); });
      dots.forEach((d, k) => { d.classList.toggle('is-active', k === idx); d.classList.toggle('w-7', k === idx); d.classList.toggle('w-1.5', k !== idx); });
      flows.forEach((f, k) => f.classList.toggle('is-active', k === idx));
    };
    const stop = () => { clearInterval(timer); timer = 0; };
    const start = () => { stop(); if (!reduced && visible && !paused) timer = window.setInterval(() => show(idx + 1), 3800); };

    dots.forEach((d, k) => d.addEventListener('click', () => { show(k); start(); }));
    flows.forEach((f, k) => {
      f.addEventListener('mouseenter', () => { paused = true; show(k); stop(); });
      f.addEventListener('mouseleave', () => { paused = false; start(); });
    });
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; start(); }, { threshold: 0.25 });
    io.observe(root);
    document.addEventListener('astro:before-swap', () => { stop(); io.disconnect(); }, { once: true });
  }
  document.addEventListener('astro:page-load', initSeedsPhone);
</script>
