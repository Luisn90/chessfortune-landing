---
import { content } from '../i18n/content';
import { getLang, localize, rich } from '../i18n';
const lang = getLang(Astro.currentLocale);
const c = content[lang];
const faqs = c.faq.items;
---

<section id="faq" class="py-24 lg:py-36">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <hr class="rule rule-fade mb-24 lg:mb-32" />
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <p data-reveal="wipe" class="eyebrow mb-5">{c.faq.eyebrow}</p>
        <h2 data-reveal="mask" style="--reveal-delay:90ms" class="text-[length:var(--text-display)]" set:html={rich(c.faq.title)} />
        <p data-reveal="up" style="--reveal-delay:200ms" class="mt-8 text-sm leading-relaxed text-mist">{c.faq.lead}</p>
        <a href={localize('/contacto', lang)} data-reveal="up" style="--reveal-delay:280ms" class="link-underline mt-6 inline-block font-sans text-[0.72rem] uppercase tracking-[0.2em] text-gold">{c.faq.link}</a>
      </div>

      <div class="lg:col-span-8">
        <div id="faq-list" class="space-y-3">
          {faqs.map((f, i) => (
            <div
              data-reveal="up"
              style={`--reveal-delay:${i * 60}ms`}
              class="faq-item overflow-hidden rounded-card border border-line/60 bg-surface/25 transition-colors duration-500 hover:border-gold/30"
              data-open="false"
            >
              <h3>
                <button type="button" aria-expanded="false" aria-controls={`faq-body-${i}`} class="faq-trigger group flex w-full items-start justify-between gap-8 px-7 py-6 text-left">
                  <span class="flex gap-6">
                    <span class="mt-1 font-sans text-[0.62rem] tracking-[0.2em] text-gold/50">0{i + 1}</span>
                    <span class="font-display text-xl leading-snug text-white transition-colors duration-400 group-hover:text-gold-soft">{f.q}</span>
                  </span>
                  <span class="accordion-icon mt-1 shrink-0 font-sans text-2xl font-light leading-none text-gold" aria-hidden="true">+</span>
                </button>
              </h3>
              <div class="accordion-body" id={`faq-body-${i}`}>
                <div><p class="max-w-2xl px-7 pb-7 pl-[4.4rem] text-[0.95rem] leading-relaxed text-mist">{f.a}</p></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initFaq() {
    const list = document.getElementById('faq-list');
    if (!list) return;
    const items = Array.from(list.querySelectorAll<HTMLElement>('.faq-item'));
    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('.faq-trigger');
      btn?.addEventListener('click', () => {
        const isOpen = item.dataset.open === 'true';
        items.forEach((o) => {
          o.dataset.open = 'false';
          o.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) { item.dataset.open = 'true'; btn.setAttribute('aria-expanded', 'true'); }
      });
    });
  }
  document.addEventListener('astro:page-load', initFaq);
</script>
