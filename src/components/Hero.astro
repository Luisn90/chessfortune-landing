---
import { site } from '../data/site';
import PlayStoreButton from './PlayStoreButton.astro';

import { content } from '../i18n/content';
import { getLang } from '../i18n';
const lang = getLang(Astro.currentLocale);
const c = content[lang];
const lines = c.hero.lines;

// Piezas de fondo (renders Blender con el desenfoque ya horneado en el WebP).
// depth: cuánto se desplazan con el ratón (cercanas más); par: parallax de scroll.
const pieces = [
  { src: 'bg-queen',  w: 239, h: 348, depth: -6,  par: 0.35, float: '15s', delay: '-4s', pos: 'hidden lg:block left-[25%] top-[6%]',                  size: 'w-[clamp(80px,7.5vw,115px)]', op: 'opacity-55' },
  { src: 'bg-bishop', w: 260, h: 382, depth: -9,  par: 0.3,  float: '14s', delay: '-9s', pos: 'hidden lg:block right-[21%] top-[9%]',                 size: 'w-[clamp(90px,8.5vw,130px)]', op: 'opacity-60' },
  { src: 'bg-pawn',   w: 245, h: 334, depth: -8,  par: 0.4,  float: '12s', delay: '-2s', pos: '-left-[3%] bottom-[5%] lg:left-[17%] lg:bottom-[5%]',  size: 'w-[20vw] max-w-[90px] lg:w-[clamp(90px,8vw,125px)] lg:max-w-none', op: 'opacity-45 lg:opacity-60' },
  { src: 'bg-rook',   w: 342, h: 456, depth: -12, par: 0.25, float: '16s', delay: '-6s', pos: '-right-[6%] bottom-[3%] lg:right-[15%] lg:-bottom-[3%]', size: 'w-[28vw] max-w-[120px] lg:w-[clamp(140px,13vw,195px)] lg:max-w-none', op: 'opacity-45 lg:opacity-70' },
  { src: 'bg-king',   w: 336, h: 546, depth: -18, par: 0.15, float: '13s', delay: '-8s', pos: '-right-[9%] top-[12%] lg:right-[6%] lg:top-[28%]',     size: 'w-[26vw] max-w-[110px] lg:w-[clamp(150px,13.5vw,205px)] lg:max-w-none', op: 'opacity-45 lg:opacity-85' },
  { src: 'bg-knight', w: 446, h: 634, depth: -26, par: 0.1,  float: '11s', delay: '0s',  pos: '-left-[8%] top-[10%] lg:left-[6%] lg:top-[19%]',      size: 'w-[30vw] max-w-[130px] lg:w-[clamp(170px,16vw,245px)] lg:max-w-none', op: 'opacity-50 lg:opacity-100' },
];
---

<section data-reveal-instant data-depth-root class="relative flex min-h-[100svh] items-center overflow-hidden pb-20 pt-28 lg:pb-24 lg:pt-32" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/2 top-1/2 size-[min(90vw,1000px)] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-50" style="background: radial-gradient(closest-side, rgba(224,169,87,0.14), rgba(224,169,87,0.04) 40%, transparent 70%)"></div>
  </div>

  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {pieces.map((p) => (
      <div data-parallax={p.par} class:list={['absolute', p.pos]}>
        <div data-depth={p.depth} class="will-change-transform">
          <img
            src={`/hero/${p.src}.webp`} alt="" width={p.w} height={p.h} decoding="async"
            class:list={[p.size, p.op]}
            style={`animation: float ${p.float} ease-in-out ${p.delay} infinite`}
          />
        </div>
      </div>
    ))}
  </div>

  <div class="relative mx-auto flex w-full max-w-[1400px] flex-col items-center px-6 text-center lg:px-10">
    <div data-reveal="up" class="mb-6 inline-flex items-center gap-3 rounded-chip lg:mb-9 border border-gold/25 bg-surface/60 px-5 py-2 backdrop-blur-sm">
        <span class="relative flex size-1.5">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-gold opacity-75"></span>
          <span class="relative inline-flex size-1.5 rounded-full bg-gold"></span>
        </span>
        <span class="eyebrow text-[0.62rem]">{c.hero.chip}</span>
      </div>

      <h1 id="hero-title" class="text-[clamp(2.3rem,4.7vw,4.3rem)]">
        {lines.map((line, i) => (
          <span class="-mb-[0.2em] block overflow-hidden pb-[0.2em] sm:whitespace-nowrap">
            <span data-reveal="mask" style={`--reveal-delay:${120 + i * 110}ms`} class:list={['block', line.accent && 'text-gilded']}>
              {line.text}
            </span>
          </span>
        ))}
      </h1>

      <p data-reveal="up" style="--reveal-delay:640ms" class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-mist sm:text-lg lg:mt-9">{c.hero.lead}</p>

      <div data-reveal="up" style="--reveal-delay:760ms" class="mt-7 flex flex-wrap items-center justify-center gap-3 sm:gap-4 lg:mt-11">
        <PlayStoreButton class="px-9 py-4 text-[0.76rem] tracking-[0.22em]" />
        <a href={site.discord} rel="noopener" class="btn-ghost border border-line px-8 py-4 font-sans text-[0.76rem] uppercase tracking-[0.22em] text-ivory">{c.common.discord}</a>
      </div>
  </div>

  <div class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 lg:flex" aria-hidden="true">
    <span class="font-sans text-[0.55rem] uppercase tracking-[0.35em] text-mist/50">{c.hero.scroll}</span>
    <span class="relative h-12 w-px overflow-hidden rounded-full bg-line">
      <span class="absolute inset-x-0 top-0 h-1/3 animate-[scrollCue_2.4s_ease-in-out_infinite] rounded-full bg-gold"></span>
    </span>
  </div>
</section>

<script>
  import '../scripts/depth';
</script>
