---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header id="site-nav" transition:persist class="fixed inset-x-0 top-0 z-70 py-4">
  <div class="mx-auto max-w-[1400px] px-4 lg:px-8">
    <div
      id="nav-shell"
      class="flex items-center justify-between rounded-panel border border-transparent px-4 py-2.5 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] data-[stuck=true]:border-line/70 data-[stuck=true]:bg-navy/80 data-[stuck=true]:backdrop-blur-xl lg:px-6"
    >
      <a href="/" class="flex items-center transition-opacity duration-400 hover:opacity-80" aria-label="Chess Fortune, inicio">
        <img src="/brand/logo.svg" alt="Chess Fortune" class="h-7 w-auto sm:h-8" width="887" height="265" />
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'link-underline group relative font-sans text-[0.82rem] uppercase tracking-[0.18em] transition-colors duration-400',
                isActive(item.href) ? 'text-gold' : 'text-mist hover:text-white',
              ]}
            >
              <span class="absolute -top-3 left-0 font-sans text-[0.55rem] tracking-[0.2em] text-gold/45 opacity-0 transition-all duration-500 group-hover:-top-4 group-hover:opacity-100">
                {item.code}
              </span>
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <a href={site.login} class="btn-ghost hidden whitespace-nowrap border border-line px-5 py-3 font-sans text-[0.7rem] uppercase tracking-[0.2em] text-ivory lg:block">
          Iniciar sesión
        </a>
        <a href={site.register} class="btn-gold hidden whitespace-nowrap px-5 py-3 font-sans text-[0.7rem] font-medium uppercase tracking-[0.2em] text-navy sm:block">
          Registrarse
        </a>
        <button
          id="menu-btn"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="menu-panel"
          class="group grid size-10 place-items-center rounded-btn border border-line bg-surface/60 md:hidden"
        >
          <span class="flex w-5 flex-col gap-[5px]">
            <span class="h-px w-full rounded-full bg-ivory transition-transform duration-400 group-aria-expanded:translate-y-[3px] group-aria-expanded:rotate-45"></span>
            <span class="h-px w-full rounded-full bg-ivory transition-transform duration-400 group-aria-expanded:-translate-y-[3px] group-aria-expanded:-rotate-45"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Panel móvil: casillas que barren dentro de un marco redondeado -->
<div id="menu-panel" inert class="pointer-events-none fixed inset-0 z-60 p-4 opacity-0 transition-opacity duration-100 md:hidden">
  <div class="relative h-full overflow-hidden rounded-panel">
    <div class="absolute inset-0 grid grid-cols-4 grid-rows-4">
      {
        Array.from({ length: 16 }).map((_, i) => (
          <span
            class="menu-tile origin-top scale-y-0 bg-surface transition-transform duration-500 ease-[cubic-bezier(0.83,0,0.17,1)]"
            style={`transition-delay:${(i % 4) * 45 + Math.floor(i / 4) * 30}ms`}
          />
        ))
      }
    </div>

    <nav class="relative flex h-full flex-col justify-center gap-2 px-8" aria-label="Menú móvil">
      {
        nav.map((item, i) => (
          <a
            href={item.href}
            class="menu-link flex translate-y-6 items-baseline gap-4 rounded-card px-4 py-4 font-display text-4xl text-white opacity-0 transition-all duration-600 ease-[cubic-bezier(0.16,1,0.3,1)]"
            style={`transition-delay:${320 + i * 70}ms`}
          >
            <span class="eyebrow text-[0.6rem]">{item.code}</span>
            {item.label}
          </a>
        ))
      }
      <div class="menu-link mt-8 flex translate-y-6 flex-wrap gap-3 opacity-0 transition-all duration-600" style="transition-delay:640ms">
        <a href={site.register} class="btn-gold px-7 py-3.5 text-[0.72rem] uppercase tracking-[0.2em] text-navy">Registrarse</a>
        <a href={site.login} class="btn-ghost border border-line px-7 py-3.5 text-[0.72rem] uppercase tracking-[0.2em] text-ivory">Iniciar sesión</a>
      </div>
    </nav>
  </div>
</div>

<script>
  /**
   * El header lleva transition:persist, así que sus nodos sobreviven a las
   * navegaciones. Si en cada astro:page-load añadiésemos listeners al botón,
   * se acumularían y cada tap alternaría N veces (la hamburguesa "muere").
   * Solución: delegación de eventos registrada UNA sola vez, con búsqueda
   * dinámica del panel (que sí se recrea en cada página).
   */
  const w = window as any;

  function setMenu(open: boolean) {
    const btn = document.getElementById('menu-btn');
    const panel = document.getElementById('menu-panel');
    if (!btn || !panel) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    panel.classList.toggle('pointer-events-none', !open);
    panel.classList.toggle('opacity-0', !open);
    if (open) panel.removeAttribute('inert');
    else panel.setAttribute('inert', '');
    panel.querySelectorAll('.menu-tile').forEach((t) => t.classList.toggle('scale-y-0', !open));
    panel.querySelectorAll('.menu-link').forEach((l) => {
      l.classList.toggle('opacity-0', !open);
      l.classList.toggle('translate-y-6', !open);
    });
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }

  function initNav() {
    // Estado "pegado" de la píldora: un único listener global
    if (!w.__cfNavScroll) {
      w.__cfNavScroll = () =>
        document.getElementById('nav-shell')?.setAttribute('data-stuck', String(window.scrollY > 40));
      window.addEventListener('scroll', w.__cfNavScroll, { passive: true });
    }
    w.__cfNavScroll();

    if (w.__cfMenuBound) return;
    w.__cfMenuBound = true;

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('#menu-btn')) {
        const btn = document.getElementById('menu-btn')!;
        setMenu(btn.getAttribute('aria-expanded') !== 'true');
      } else if (t.closest('#menu-panel a')) {
        setMenu(false);
      }
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

    // Red de seguridad: al navegar, nunca dejar el scroll bloqueado
    document.addEventListener('astro:after-swap', () => {
      document.documentElement.style.overflow = '';
      document.getElementById('menu-btn')?.setAttribute('aria-expanded', 'false');
    });
  }

  document.addEventListener('astro:page-load', initNav);
</script>
