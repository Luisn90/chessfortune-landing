---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { content } from '../i18n/content';
import { getLang } from '../i18n';
const lang = getLang(Astro.currentLocale);

const t = content[lang].pages.contacto;
const channels = t.channels.map((ch) => ({ ...ch, href: ch.href === 'discord' ? site.discord : ch.href }));
const input = 'w-full rounded-btn border border-line bg-surface/50 px-5 py-4 text-sm text-ivory transition-colors duration-400 focus:border-gold focus:outline-none';
---

<Layout title={t.title} description={t.description}>
  <PageHeader eyebrow={t.eyebrow} title={t.heading} accent={t.accent} lead={t.lead} />

  <section class="py-20 lg:py-28">
    <div class="mx-auto grid max-w-[1400px] gap-16 px-6 lg:grid-cols-12 lg:gap-20 lg:px-10">
      <div class="lg:col-span-5">
        <ul class="space-y-3">
          {channels.map((c, i) => (
            <li
              data-reveal="left"
              style={`--reveal-delay:${i * 90}ms`}
              class="spotlight group relative rounded-card border border-line/60 bg-surface/30 p-7 transition-colors duration-500 hover:border-gold/35 hover:bg-surface"
            >
              <p class="eyebrow text-[0.56rem]">{c.label}</p>
              <a href={c.href} class="link-underline mt-3 inline-block font-display text-lg text-white transition-colors duration-400 group-hover:text-gold-soft">{c.value}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-7">
        <form id="contact-form" class="grid gap-5 sm:grid-cols-2" novalidate data-msg-invalid={t.form.invalid} data-msg-sent={t.form.sent}>
          <div data-reveal="up" class="sm:col-span-1">
            <label for="name" class="eyebrow mb-3 block text-[0.56rem]">{t.form.name}</label>
            <input id="name" name="name" required class={input} />
          </div>
          <div data-reveal="up" style="--reveal-delay:80ms" class="sm:col-span-1">
            <label for="cemail" class="eyebrow mb-3 block text-[0.56rem]">{t.form.email}</label>
            <input id="cemail" name="email" type="email" required class={input} />
          </div>
          <div data-reveal="up" style="--reveal-delay:160ms" class="sm:col-span-2">
            <label for="subject" class="eyebrow mb-3 block text-[0.56rem]">{t.form.subject}</label>
            <select id="subject" name="subject" class:list={[input, 'appearance-none']}>
              {t.form.options.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div data-reveal="up" style="--reveal-delay:240ms" class="sm:col-span-2">
            <label for="message" class="eyebrow mb-3 block text-[0.56rem]">{t.form.message}</label>
            <textarea id="message" name="message" rows="6" required class:list={[input, 'resize-none']}></textarea>
          </div>
          <div data-reveal="up" style="--reveal-delay:320ms" class="sm:col-span-2">
            <button type="submit" class="btn-gold px-10 py-4 font-sans text-[0.72rem] font-medium uppercase tracking-[0.2em] text-navy">{t.form.submit}</button>
            <p id="contact-msg" role="status" class="mt-4 h-5 font-sans text-xs text-gold"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script>
    function initContact() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const msg = document.getElementById('contact-msg');
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!msg) return;
        if (!form.checkValidity()) {
          msg.style.color = '#e07a5f';
          msg.textContent = form.dataset.msgInvalid || '';
          return;
        }
        msg.style.color = '';
        msg.textContent = form.dataset.msgSent || '';
        form.reset();
      });
    }
    document.addEventListener('astro:page-load', initContact);
  </script>
</Layout>
