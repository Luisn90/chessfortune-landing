---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Steps from '../components/Steps.astro';
import Features from '../components/Features.astro';
import Security from '../components/Security.astro';
import { content } from '../i18n/content';
import { getLang, rich } from '../i18n';
const lang = getLang(Astro.currentLocale);
const t = content[lang].pages.juego;
---

<Layout title={t.title} description={t.description}>
  <PageHeader eyebrow={t.eyebrow} title={t.heading} accent={t.accent} lead={t.lead} />
  <Steps />
  <Features />
  <Security />
</Layout>
