---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Seeds from '../components/Seeds.astro';
import Faq from '../components/Faq.astro';
import { content } from '../i18n/content';
import { getLang } from '../i18n';
const lang = getLang(Astro.currentLocale);

const t = content[lang].pages.seeds;
---

<Layout title={t.title} description={t.description}>
  <PageHeader eyebrow={t.eyebrow} title={t.heading} accent={t.accent} lead={t.lead} />

  <Seeds />

  <section class="pb-8">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
      <p data-reveal="up" class="mx-auto max-w-3xl rounded-card border border-line/60 bg-surface/30 px-6 py-5 text-center text-xs leading-relaxed text-mist/80 lg:px-10">
        {t.disclaimer}
      </p>
    </div>
  </section>

  <Faq />
</Layout>
