---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { content } from '../i18n/content';
import { getLang } from '../i18n';
const lang = getLang(Astro.currentLocale);

const t = content[lang].pages.terminos;
const sections = t.sections;
---

<Layout title={t.title} description={t.description}>
  <PageHeader eyebrow={t.eyebrow} title={t.heading} accent={t.accent} lead={t.lead} />

  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-3xl space-y-4 px-6 lg:px-10">
      {sections.map((s, i) => (
        <article data-reveal="up" style={`--reveal-delay:${i * 60}ms`} class="rounded-card border border-line/60 bg-surface/25 p-8 lg:p-10">
          <h2 class="text-xl text-white">{s.h}</h2>
          <p class="mt-4 leading-relaxed text-mist">{s.p}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
