---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import { site } from '../data/site';
import { content } from '../i18n/content';
import { getLang, localize, locales } from '../i18n';

interface Props { title?: string; description?: string }
const lang = getLang(Astro.currentLocale);
const c = content[lang];
const { title, description = c.meta.description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${c.meta.tagline}`;
const siteUrl = Astro.site ?? 'https://chessfortune.com';
const pageUrl = new URL(localize(Astro.url.pathname, lang), siteUrl).href;
const ogImage = new URL(lang === 'en' ? '/og-en.jpg' : '/og.jpg', siteUrl).href;
const isHome = localize(Astro.url.pathname, 'es') === '/';
// Datos estructurados: organización + web en todas las páginas; la app en la home
const ld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Chess Fortune',
    url: siteUrl.toString(),
    logo: new URL('/brand/logo.svg', siteUrl).href,
    sameAs: [site.instagram, site.youtube, site.facebook, site.discord],
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Chess Fortune', url: siteUrl.toString(), inLanguage: lang },
];
if (isHome) ld.push({
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Chess Fortune',
  operatingSystem: 'ANDROID',
  applicationCategory: 'GameApplication',
  description: c.meta.description,
  contentRating: 'Mature 17+',
  installUrl: site.playStore,
  url: site.playStore,
  image: ogImage,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'Chess Fortune' },
});
---

<!doctype html>
<html lang={lang} class="scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#090c16" />
    <link rel="icon" type="image/svg+xml" href="/brand/seed.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localize(Astro.url.pathname, l), siteUrl)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localize(Astro.url.pathname, 'es'), siteUrl)} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chess Fortune" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />

    <ClientRouter />
  </head>

  <body class="antialiased">
    <div id="cursor" aria-hidden="true"></div>

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-btn focus:bg-gold focus:px-4 focus:py-2 focus:text-navy">
      {c.meta.skip}
    </a>

    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <CookieBanner />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function initReveals() {
        const items = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
        if (reduced) { items.forEach((el) => el.classList.add('is-in')); return; }
        // Lo que está dentro de [data-reveal-instant] (el hero) entra al cargar,
        // sin esperar a que cruce el margen inferior: el CTA nunca debe quedar oculto.
        const instant = Array.from(items).filter((el) => el.closest('[data-reveal-instant]'));
        requestAnimationFrame(() => requestAnimationFrame(() => instant.forEach((el) => el.classList.add('is-in'))));
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }),
          // threshold DEBE ser 0: los reveals 'mask' y 'wipe' arrancan con
          // clip-path, que recorta el área de intersección a cero. Con un
          // umbral mayor que 0 nunca dispararían y quedarían invisibles.
          { rootMargin: '0px 0px -12% 0px', threshold: 0 }
        );
        items.forEach((el) => { if (!el.closest('[data-reveal-instant]')) io.observe(el); });
      }

      function initCounters() {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            io.unobserve(el);
            const target = parseFloat(el.dataset.count || '0');
            const decimals = parseInt(el.dataset.decimals || '0', 10);
            if (reduced) { el.textContent = target.toFixed(decimals); return; }
            const start = performance.now();
            const tick = (now: number) => {
              const p = Math.min((now - start) / 1600, 1);
              el.textContent = (target * (1 - Math.pow(1 - p, 4))).toFixed(decimals);
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }),
          { threshold: 0.5 }
        );
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => io.observe(el));
      }

      /**
       * Con View Transitions, astro:page-load se dispara en CADA navegación.
       * El #cursor y las tarjetas se recrean con cada página, así que:
       * - el bucle rAF del cursor debe cancelarse y relanzarse (o quedaría
       *   apuntando a un nodo muerto y el cursor "moriría" tras navegar), y
       * - los listeners de window/document deben registrarse UNA vez
       *   (delegación) o retirarse antes de re-añadirse, para no acumularse
       *   y degradar el rendimiento navegación tras navegación.
       */
      const w = window as any;

      function initPointer() {
        if (reduced) return;
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        // ── Cursor dorado: relanzar por página ──
        const cursor = document.getElementById('cursor');
        if (fine && cursor) {
          document.body.classList.add('has-cursor');
          if (w.__cfCursorRaf) cancelAnimationFrame(w.__cfCursorRaf);
          if (w.__cfCursorMove) window.removeEventListener('pointermove', w.__cfCursorMove);
          let x = 0, y = 0, cx = innerWidth / 2, cy = innerHeight / 2;
          w.__cfCursorMove = (e: PointerEvent) => { x = e.clientX; y = e.clientY; cursor.style.opacity = '1'; };
          window.addEventListener('pointermove', w.__cfCursorMove);
          const loop = () => {
            cx += (x - cx) * 0.18; cy += (y - cy) * 0.18;
            cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
            w.__cfCursorRaf = requestAnimationFrame(loop);
          };
          loop();
        }

        // ── Crecimiento del cursor sobre enlaces: delegación única ──
        if (fine && !w.__cfHoverBound) {
          w.__cfHoverBound = true;
          document.addEventListener('pointerover', (e) => {
            const c = document.getElementById('cursor');
            if (!c) return;
            c.classList.toggle('is-hovering', !!(e.target as HTMLElement).closest?.('a, button, [data-cursor]'));
          });
        }

        // ── Tilt 3D + halo: delegación única (las tarjetas cambian por página) ──
        if (!w.__cfTiltBound) {
          w.__cfTiltBound = true;
          document.addEventListener('pointermove', (e) => {
            const card = (e.target as HTMLElement).closest?.('.tilt, .spotlight') as HTMLElement | null;
            if (!card) return;
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width;
            const py = (e.clientY - r.top) / r.height;
            card.style.setProperty('--mx', `${px * 100}%`);
            card.style.setProperty('--my', `${py * 100}%`);
            if (card.classList.contains('tilt')) {
              card.style.setProperty('--ry', `${(px - 0.5) * 11}deg`);
              card.style.setProperty('--rx', `${(0.5 - py) * 11}deg`);
            }
          });
          document.addEventListener('pointerout', (e) => {
            const card = (e.target as HTMLElement).closest?.('.tilt') as HTMLElement | null;
            if (!card || card.contains(e.relatedTarget as Node)) return;
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--rx', '0deg');
          });
        }
      }

      function initParallax() {
        if (reduced) return;
        if (w.__cfParallaxFn) window.removeEventListener('scroll', w.__cfParallaxFn);
        const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
        if (!layers.length) { w.__cfParallaxFn = null; return; }
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          layers.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) return;
            const speed = parseFloat(el.dataset.parallax || '0.1');
            el.style.transform = `translate3d(0, ${-((r.top + r.height / 2 - vh / 2) * speed)}px, 0)`;
          });
          ticking = false;
        };
        w.__cfParallaxFn = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        window.addEventListener('scroll', w.__cfParallaxFn, { passive: true });
        update();
      }

      document.addEventListener('astro:page-load', () => {
        initReveals();
        initCounters();
        initPointer();
        initParallax();
      });
    </script>
  </body>
</html>
